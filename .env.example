# Copy to .env.local for local overrides. Never commit real values; production secrets
# live in Azure Key Vault (see AGENTS.md).

# Shows the component review page (/dev/ui) in a production build, e.g. for the preview.
SHOW_UI_REVIEW=false

# Dev only: extra hostnames allowed to open the dev server (e.g. your Tailscale IP to test on
# a phone). Comma-separated hostnames, no scheme or port. Set it in .env.local, not here.
DEV_ALLOWED_ORIGINS=
